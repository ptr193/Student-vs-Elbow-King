{
  "appId": "com.trae.qiyijunzhoujiwang",
  "appName": "起义军大战肘击王",
  "webDir": "./",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "hostname": "app.localhost"
  },
  "android": {
    "defaultPlugins": {
      "SplashScreen": {
        "launchShowDuration": 800,
        "backgroundColor": "#0a0a14",
        "showSpinner": false,
        "splashFullScreen": true,
        "splashImmersive": true,
        "splashAlwaysShow": true
      },
      "StatusBar": {
        "backgroundColor": "#0a0a14",
        "style": "DARK"
      }
    }
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#0a0a14",
      "showSpinner": false
    }
  }
}
