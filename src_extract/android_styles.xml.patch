<!--
  把下面这段 XML 追加到（或替换同名文件）：
    android/app/src/main/res/values/styles.xml
  作用：
    · 隐藏默认 ActionBar / 标题栏（全屏沉浸游戏体验）
    · 保持深色背景与 theme-color (#0a0a14) 一致
  注：build-android.sh / build-android.bat 已尽可能通过 manifest 注入，但某些
      Capacitor 版本会生成 styles.xml 默认带 ActionBar，这份 patch 用来兜底。
-->
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme.NoActionBar" parent="Theme.MaterialComponents.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">#0a0a14</item>
        <item name="android:navigationBarColor">#0a0a14</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

</resources>
